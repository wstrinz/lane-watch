{
  "name": "agent-observer",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vite build",
    "build:flow": "bun run build:ui",
    "test:flow": "playwright test --config playwright.flow.config.ts",
    "dev": "vite build --watch",
    "start": "bun src/server.ts",
    "test": "bun test --timeout 30000",
    "check": "bun run build:ui && bun run test && bunx tsc --noEmit && bunx svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.6.5",
    "svelte": "^5.56.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
